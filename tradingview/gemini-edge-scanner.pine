// Gemini Edge Scanner — Options IQ Gemini (single-name, buyer-only)
// Paste into TradingView Pine Editor -> Add to chart. Use D (Daily), 1-2 year view.
// Screenshot and paste to the Directional Builder skill alongside the ticker.
//
// What this adds:
//   - EMA 21 (orange), EMA 50 (blue), EMA 200 (gold) lines + trend background tint
//   - Dashboard table top-right: every number Claude needs to read, one clean panel
//   - Buyer-only directional bias: CALL (buy) / PUT (buy) verdicts
//   - S/R zones (shaded boxes, nearest-3, distance-evicted) with price labels
//   - 52-week high/low reference lines
//   - Pattern markers: BASE, WEDGE, TRIANGLE, BREAK / FAILED (with volume confirm)
//   - Volume-colored candles (bright = RVOL >= 1.5)

//@version=6
indicator("Gemini Edge Scanner", overlay=true, max_boxes_count=20, max_labels_count=50, max_lines_count=10)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
i_pl      = input.int(10,    "Pivot Left Bars",           group="S/R",      minval=3)
i_pr      = input.int(10,    "Pivot Right Bars",          group="S/R",      minval=3)
i_zone    = input.float(0.75,"Zone half-width (%)",       group="S/R",      minval=0.1, maxval=3.0)
i_cluster = input.float(1.5, "Cluster radius (%)",        group="S/R",      minval=0.5, maxval=5.0)
i_prox    = input.float(25.0,"Price proximity filter (%)",group="S/R",      minval=5.0, maxval=50.0)
i_e21     = input.int(21,    "EMA Fast",                  group="Trend")
i_e50     = input.int(50,    "EMA Mid",                   group="Trend")
i_e200    = input.int(200,   "EMA Slow",                  group="Trend")
i_batr    = input.float(0.65,"Base: ATR ratio threshold", group="Patterns", minval=0.3, maxval=1.0)
i_bbars   = input.int(5,     "Base: min tight bars",      group="Patterns", minval=2)
i_wslope  = input.float(0.0005,"Wedge slope threshold (linreg Δ as frac of price/bar)", group="Patterns", minval=0.0001, maxval=0.01, step=0.0001)
i_wnarrow = input.float(0.85,  "Base narrowing: BB-width vs its 40d avg",               group="Patterns", minval=0.50, maxval=0.98, step=0.01)
i_vlen    = input.int(20,    "Volume MA length",          group="Volume")
i_rvol    = input.float(1.5, "High-vol RVOL threshold",   group="Volume")

// ─── HELPERS ──────────────────────────────────────────────────────────────────
p(v, d)    => str.tostring(math.round(v, d))
fp(v)      => na(v) ? "--" : "$" + p(v, 2)
sgn(v)     => v >= 0 ? "+" : ""
pct_str(v) => sgn(v) + p(v, 1) + "%"

// ─── TREND EMAs ───────────────────────────────────────────────────────────────
e21       = ta.ema(close, i_e21)
e50       = ta.ema(close, i_e50)
e200      = ta.ema(close, i_e200)
no_ema200 = na(e200)   // true when chart has < 200 bars — guards all EMA-200 expressions below

plot(e21,  "EMA 21",  color=color.orange, linewidth=1)
plot(e50,  "EMA 50",  color=color.blue,   linewidth=2)
plot(e200, "EMA 200", color=#FFD700,      linewidth=2)

// ─── TREND STRUCTURE ─────────────────────────────────────────────────────────
uptrend   = close > e200 and e50 > e200 and e21 > e50
downtrend = close < e200 and e50 < e200 and e21 < e50

bgcolor(uptrend ? color.new(color.green, 93) : downtrend ? color.new(color.red, 93) : color.new(color.gray, 96), title="Trend Tint")

trend_str = no_ema200 ? "INSUFFICIENT HISTORY" : uptrend ? "UPTREND  [GO]" : downtrend ? "DOWNTREND [BLOCK]" : "NEUTRAL  [WAIT]"
trend_col = no_ema200 ? color.gray : uptrend ? color.green : downtrend ? color.red : color.gray

// ─── DERIVED METRICS ─────────────────────────────────────────────────────────
pct200 = (close - e200) / e200 * 100
pct50  = (close - e50)  / e50  * 100
pct21  = (close - e21)  / e21  * 100

sl200 = no_ema200 ? "--" : e200 > e200[5] ? "↑" : e200 < e200[5] ? "↓" : "→"
sl50  = e50  > e50[5]  ? "↑" : e50  < e50[5]  ? "↓" : "→"
sl21  = e21  > e21[3]  ? "↑" : e21  < e21[3]  ? "↓" : "→"

atr14    = ta.atr(14)
atr_pct  = atr14 / close * 100
rsi14    = ta.rsi(close, 14)
rsi_note = rsi14 >= 70 ? "OVERBOUGHT" : rsi14 <= 30 ? "OVERSOLD" : "NEUTRAL"
rsi_col  = rsi14 >= 70 ? color.red : rsi14 <= 30 ? color.green : color.white

vol_ma  = ta.sma(volume, i_vlen)
rvol    = volume / vol_ma
hi_vol  = rvol >= i_rvol
bull_c  = close >= open
// Dashboard RVOL uses the LAST COMPLETED bar — the forming intraday bar has partial volume
// and would read a misleadingly low RVOL (e.g. 0.05x) if screenshotted right after the open.
rvol_disp = volume[1] / ta.sma(volume, i_vlen)[1]
vol_str   = p(rvol_disp, 2) + "x avg"
vol_col   = rvol_disp >= i_rvol ? color.green : rvol_disp <= 0.5 ? color.rgb(150, 150, 150) : color.white

// ─── DIRECTIONAL BIAS (buyer only — debit calls / puts) ──────────────────────
// CALL: buy in an uptrend (above 200 EMA). PUT: buy in a downtrend (below 200 EMA).
gate_call     = no_ema200 ? "N/A" : close > e200 ? (close > e50 ? "GO" : "WARN") : "BLOCK"
gate_put      = no_ema200 ? "N/A" : close < e200 ? (close < e50 ? "GO" : "WARN") : "BLOCK"
gate_call_col = no_ema200 ? color.gray : close > e200 ? (close > e50 ? color.green : color.orange) : color.red
gate_put_col  = no_ema200 ? color.gray : close < e200 ? (close < e50 ? color.green : color.orange) : color.red

// ─── S/R ZONE ARRAYS ─────────────────────────────────────────────────────────
var array<box>   res_boxes  = array.new<box>()
var array<float> res_levels = array.new<float>()
var array<box>   sup_boxes  = array.new<box>()
var array<float> sup_levels = array.new<float>()

// Every pivot ever confirmed, kept for the life of the chart, plus a "broken" flag
// once role reversal has already flipped it to the other side. Lets a pivot that was
// too far from price (rejected by the proximity filter) at confirmation time re-enter
// later as price approaches it — without resurrecting one already flipped.
var array<float> all_res_pivots = array.new<float>()
var array<int>   all_res_bars   = array.new<int>()
var array<bool>  all_res_broken = array.new<bool>()
var array<float> all_sup_pivots = array.new<float>()
var array<int>   all_sup_bars   = array.new<int>()
var array<bool>  all_sup_broken = array.new<bool>()

f_clustered(array<float> levels, float price) =>
    hit = false
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            if math.abs(array.get(levels, i) - price) / price < i_cluster / 100.0
                hit := true
                break
    hit

f_furthest_idx(array<float> levels) =>
    fi = 0
    fd = 0.0
    for i = 0 to array.size(levels) - 1
        d = math.abs(array.get(levels, i) - close)
        if d > fd
            fd := d
            fi := i
    fi

f_sorted_asc(array<float> arr) =>
    c = array.copy(arr)
    array.sort(c, order.ascending)
    c

f_make_zone(float lvl, bool isRes, int left_bar) =>
    zt  = lvl * (1 + i_zone / 100)
    zb  = lvl * (1 - i_zone / 100)
    col = isRes ? color.red : color.green
    box.new(left_bar, zt, bar_index, zb, border_color=color.new(col, 40), bgcolor=color.new(col, 75), text=(isRes ? "R  $" : "S  $") + str.tostring(lvl, format.mintick), text_size=size.tiny, text_color=color.white, text_halign=text.align_right, text_valign=text.align_center)

f_mark_broken(array<float> master, array<bool> broken, float lvl) =>
    if array.size(master) > 0
        for i = 0 to array.size(master) - 1
            if array.get(master, i) == lvl and not array.get(broken, i)
                array.set(broken, i, true)
                break

// Role reversal: broken resistance becomes support; broken support becomes resistance.
// A level price closes strictly above is proven as a floor — promote resistance to support.
// A level price closes at-or-below is proven as ceiling — promote support to resistance.
// The resistance side is strict (`<` not `<=`) so an exact close==level bar can only
// satisfy one of the two conditions, not both — previously an exact match could flip a
// level to the other side and then flip straight back within the same bar (double-flip).
// The whole block is gated on barstate.isconfirmed: mutating zones on the still-forming
// live bar caused a level to flip and un-flip on every intrabar tick until the bar closed
// (repaint). Iterate backwards so index removal doesn't corrupt the loop.
if barstate.isconfirmed
    if array.size(res_levels) > 0
        for i = array.size(res_levels) - 1 to 0
            lvl = array.get(res_levels, i)
            if lvl < close
                f_mark_broken(all_res_pivots, all_res_broken, lvl)
                box.delete(array.get(res_boxes, i))
                array.remove(res_boxes,  i)
                array.remove(res_levels, i)
                if not f_clustered(sup_levels, lvl)
                    if array.size(sup_boxes) < 3
                        array.push(sup_boxes,  f_make_zone(lvl, false, bar_index))
                        array.push(sup_levels, lvl)
                    else
                        fi = f_furthest_idx(sup_levels)
                        if math.abs(array.get(sup_levels, fi) - close) > (close - lvl)
                            box.delete(array.get(sup_boxes, fi))
                            array.remove(sup_boxes,  fi)
                            array.remove(sup_levels, fi)
                            array.push(sup_boxes,  f_make_zone(lvl, false, bar_index))
                            array.push(sup_levels, lvl)
    if array.size(sup_levels) > 0
        for i = array.size(sup_levels) - 1 to 0
            lvl = array.get(sup_levels, i)
            if lvl >= close
                f_mark_broken(all_sup_pivots, all_sup_broken, lvl)
                box.delete(array.get(sup_boxes, i))
                array.remove(sup_boxes,  i)
                array.remove(sup_levels, i)
                if not f_clustered(res_levels, lvl)
                    if array.size(res_boxes) < 3
                        array.push(res_boxes,  f_make_zone(lvl, true, bar_index))
                        array.push(res_levels, lvl)
                    else
                        fi = f_furthest_idx(res_levels)
                        if math.abs(array.get(res_levels, fi) - close) > (lvl - close)
                            box.delete(array.get(res_boxes, fi))
                            array.remove(res_boxes,  fi)
                            array.remove(res_levels, fi)
                            array.push(res_boxes,  f_make_zone(lvl, true, bar_index))
                            array.push(res_levels, lvl)

// Keep every surviving zone stretched to the current bar
if array.size(res_boxes) > 0
    for i = 0 to array.size(res_boxes) - 1
        box.set_right(array.get(res_boxes, i), bar_index)
if array.size(sup_boxes) > 0
    for i = 0 to array.size(sup_boxes) - 1
        box.set_right(array.get(sup_boxes, i), bar_index)

// ─── PIVOT DETECTION & ZONE DRAWING (nearest-3, distance-evicted) ─────────────
ph = ta.pivothigh(high, i_pl, i_pr)
pl = ta.pivotlow(low,   i_pl, i_pr)

var float last_r = na
var float last_s = na

// Gated on barstate.isconfirmed: ta.pivothigh/pivotlow use the still-forming bar as
// part of their right-side lookback, so the pivot value itself (and everything built
// from it below) can repaint intrabar until the bar closes.
if barstate.isconfirmed
    if not na(ph)
        last_r := ph
        array.push(all_res_pivots, ph)
        array.push(all_res_bars,   bar_index[i_pr])
        array.push(all_res_broken, false)
        is_res = ph > close and ph < close * (1 + i_prox / 100)
        if is_res and not f_clustered(res_levels, ph)
            if array.size(res_boxes) < 3
                array.push(res_boxes,  f_make_zone(ph, true, bar_index[i_pr]))
                array.push(res_levels, ph)
            else
                fi = f_furthest_idx(res_levels)
                if math.abs(array.get(res_levels, fi) - close) > (ph - close)
                    box.delete(array.get(res_boxes, fi))
                    array.remove(res_boxes,  fi)
                    array.remove(res_levels, fi)
                    array.push(res_boxes,  f_make_zone(ph, true, bar_index[i_pr]))
                    array.push(res_levels, ph)

    if not na(pl)
        last_s := pl
        array.push(all_sup_pivots, pl)
        array.push(all_sup_bars,   bar_index[i_pr])
        array.push(all_sup_broken, false)
        is_sup = pl < close and pl > close * (1 - i_prox / 100)
        if is_sup and not f_clustered(sup_levels, pl)
            if array.size(sup_boxes) < 3
                array.push(sup_boxes,  f_make_zone(pl, false, bar_index[i_pr]))
                array.push(sup_levels, pl)
            else
                fi = f_furthest_idx(sup_levels)
                if math.abs(array.get(sup_levels, fi) - close) > (close - pl)
                    box.delete(array.get(sup_boxes, fi))
                    array.remove(sup_boxes,  fi)
                    array.remove(sup_levels, fi)
                    array.push(sup_boxes,  f_make_zone(pl, false, bar_index[i_pr]))
                    array.push(sup_levels, pl)

    // Fallback (Bug B / ECHO-class): a pivot rejected by the proximity filter at
    // confirmation time previously never got another chance. Re-scan the full pivot
    // history each confirmed bar and admit any not-yet-broken pivot now in range.
    if array.size(all_res_pivots) > 0
        for i = 0 to array.size(all_res_pivots) - 1
            lvl = array.get(all_res_pivots, i)
            if not array.get(all_res_broken, i) and lvl > close and lvl < close * (1 + i_prox / 100) and not f_clustered(res_levels, lvl)
                if array.size(res_boxes) < 3
                    array.push(res_boxes,  f_make_zone(lvl, true, array.get(all_res_bars, i)))
                    array.push(res_levels, lvl)
                else
                    fi = f_furthest_idx(res_levels)
                    if math.abs(array.get(res_levels, fi) - close) > (lvl - close)
                        box.delete(array.get(res_boxes, fi))
                        array.remove(res_boxes,  fi)
                        array.remove(res_levels, fi)
                        array.push(res_boxes,  f_make_zone(lvl, true, array.get(all_res_bars, i)))
                        array.push(res_levels, lvl)
    if array.size(all_sup_pivots) > 0
        for i = 0 to array.size(all_sup_pivots) - 1
            lvl = array.get(all_sup_pivots, i)
            if not array.get(all_sup_broken, i) and lvl < close and lvl > close * (1 - i_prox / 100) and not f_clustered(sup_levels, lvl)
                if array.size(sup_boxes) < 3
                    array.push(sup_boxes,  f_make_zone(lvl, false, array.get(all_sup_bars, i)))
                    array.push(sup_levels, lvl)
                else
                    fi = f_furthest_idx(sup_levels)
                    if math.abs(array.get(sup_levels, fi) - close) > (close - lvl)
                        box.delete(array.get(sup_boxes, fi))
                        array.remove(sup_boxes,  fi)
                        array.remove(sup_levels, fi)
                        array.push(sup_boxes,  f_make_zone(lvl, false, array.get(all_sup_bars, i)))
                        array.push(sup_levels, lvl)

// ─── 52-WEEK HIGH / LOW ───────────────────────────────────────────────────────
high_52w = ta.highest(high, 252)
low_52w  = ta.lowest(low,  252)

var line l_52h = na
var line l_52l = na

if barstate.islast
    line.delete(l_52h)
    line.delete(l_52l)
    x_left = math.max(bar_index - 252, 0)
    if not na(high_52w)
        l_52h := line.new(x_left, high_52w, bar_index, high_52w, color=color.orange, style=line.style_dashed, width=1)
    if not na(low_52w)
        l_52l := line.new(x_left, low_52w,  bar_index, low_52w,  color=color.teal,   style=line.style_dashed, width=1)

// ─── BASE / CONSOLIDATION ────────────────────────────────────────────────────
atr_avg = ta.sma(atr14, 20)
tight   = atr14 < atr_avg * i_batr

var int tight_run = 0
tight_run := tight ? tight_run + 1 : 0
in_base   = tight_run >= i_bbars

bgcolor(in_base ? color.new(color.purple, 87) : na, title="Base / Consolidation")

if in_base and not in_base[1]
    label.new(bar_index, low * 0.995, "BASE (" + str.tostring(tight_run, "#") + "d)", style=label.style_label_up, color=color.purple, textcolor=color.white, size=size.small)

// ─── WEDGE DETECTION ─────────────────────────────────────────────────────────
res_slope = (ta.linreg(high, 20, 0) - ta.linreg(high, 20, 1)) / close
sup_slope = (ta.linreg(low,  20, 0) - ta.linreg(low,  20, 1)) / close

bb_mid    = ta.sma(close, 20)
bb_width  = 4.0 * ta.stdev(close, 20) / bb_mid
narrowing = bb_width < ta.sma(bb_width, 40) * i_wnarrow
wedge_ctx = in_base or narrowing

sym_tri   = wedge_ctx and res_slope < -i_wslope and sup_slope >  i_wslope
asc_wedge = wedge_ctx and res_slope >  i_wslope and sup_slope >  i_wslope and sup_slope > res_slope
dsc_wedge = wedge_ctx and res_slope < -i_wslope and sup_slope < -i_wslope and sup_slope > res_slope

if barstate.islast
    if sym_tri
        label.new(bar_index, ta.highest(high, 20) * 1.002, "△  TRIANGLE", style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
    else if asc_wedge
        label.new(bar_index, ta.highest(high, 20) * 1.002, "⌒  WEDGE ▲  bearish", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)
    else if dsc_wedge
        label.new(bar_index, ta.highest(high, 20) * 1.002, "⌣  WEDGE ▼  bullish", style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.small)

// ─── VOLUME-COLORED CANDLES ──────────────────────────────────────────────────
barcolor(hi_vol and bull_c ? color.lime : hi_vol and not bull_c ? color.red : bull_c ? color.new(color.green, 50) : color.new(color.red, 50), title="Volume-Colored Candles")

// ─── BREAKOUT / BREAKDOWN / FAILED ───────────────────────────────────────────
breakout  = not na(last_r) and close > last_r and close[1] <= last_r and hi_vol
breakdown = not na(last_s) and close < last_s and close[1] >= last_s and hi_vol
failed_bo = not na(last_r) and high[1] <= last_r and high > last_r and close < last_r
failed_bd = not na(last_s) and low[1]  >= last_s and low  < last_s and close > last_s

plotshape(breakout,  "Breakout",         shape.triangleup,   location.abovebar, color.lime,   size=size.small, text="BREAK↑")
plotshape(breakdown, "Breakdown",        shape.triangledown, location.belowbar, color.red,    size=size.small, text="BREAK↓")
plotshape(failed_bo, "Failed Breakout",  shape.xcross,       location.abovebar, color.orange, size=size.small, text="FAILED↑")
plotshape(failed_bd, "Failed Breakdown", shape.xcross,       location.belowbar, color.orange, size=size.small, text="FAILED↓")

// Current-bar pattern state for the dashboard
pattern_str = breakout ? "BREAK ↑" : breakdown ? "BREAK ↓" : failed_bo ? "FAILED ↑ trap" : failed_bd ? "FAILED ↓ trap" : asc_wedge ? "WEDGE ↑ bearish" : dsc_wedge ? "WEDGE ↓ bullish" : sym_tri ? "TRIANGLE" : in_base ? "BASE (" + str.tostring(tight_run, "#") + "d)" : "—"
pattern_col = breakout ? color.green : breakdown ? color.red : failed_bo ? color.red : failed_bd ? color.green : asc_wedge ? color.orange : dsc_wedge ? color.green : sym_tri ? color.gray : in_base ? color.orange : color.gray

// ─── DASHBOARD TABLE ─────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 23, bgcolor=color.rgb(8, 10, 20, 5), border_color=color.rgb(50, 55, 85), border_width=1, frame_color=color.rgb(70, 90, 170), frame_width=2)

if barstate.islast
    bg_hdr = color.rgb(15, 22, 65)
    bg_sep = color.rgb(12, 14, 28)
    c_lbl  = color.rgb(130, 140, 185)
    c_sep  = color.rgb(45, 50, 80)

    // Nearest S/R from the drawn zones (all res above price, all sup below)
    rs   = f_sorted_asc(res_levels)
    ss   = f_sorted_asc(sup_levels)
    nres = array.size(rs)
    nsup = array.size(ss)
    r1 = nres >= 1 ? array.get(rs, 0) : na
    r2 = nres >= 2 ? array.get(rs, 1) : na
    s1 = nsup >= 1 ? array.get(ss, nsup - 1) : na
    s2 = nsup >= 2 ? array.get(ss, nsup - 2) : na

    table.cell(t, 0, 0, "GEMINI EDGE SCANNER", text_color=color.white, bgcolor=bg_hdr, text_size=size.small)
    table.cell(t, 1, 0, syminfo.ticker + "  " + timeframe.period, text_color=color.rgb(180, 195, 255), bgcolor=bg_hdr, text_size=size.small)
    table.cell(t, 0, 1, "Price",           text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 1, "$" + p(close, 2), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "Trend",   text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 2, trend_str, text_color=trend_col, text_size=size.small)
    table.cell(t, 0, 3, "-- EMAs -----------------------", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 1, 3, "", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 0, 4, "EMA 200  " + sl200, text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 4, no_ema200 ? "--  (<200 bars)" : fp(e200) + "   " + pct_str(pct200), text_color=no_ema200 ? color.gray : close > e200 ? color.green : color.red, text_size=size.small)
    table.cell(t, 0, 5, "EMA 50   " + sl50, text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 5, fp(e50) + "   " + pct_str(pct50), text_color=close > e50 ? color.green : color.red, text_size=size.small)
    table.cell(t, 0, 6, "EMA 21   " + sl21, text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 6, fp(e21) + "   " + pct_str(pct21), text_color=close > e21 ? color.green : color.orange, text_size=size.small)
    table.cell(t, 0, 7, "-- Momentum -------------------", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 1, 7, "", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 0, 8, "ATR(14)", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 8, fp(atr14) + "   (" + p(atr_pct, 1) + "% daily)", text_color=color.white, text_size=size.small)
    table.cell(t, 0, 9, "RSI(14)", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 9, p(rsi14, 1) + "  " + rsi_note, text_color=rsi_col, text_size=size.small)
    table.cell(t, 0, 10, "Vol / 20d (last close)", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 10, vol_str, text_color=vol_col, text_size=size.small)
    table.cell(t, 0, 11, "-- Bias: buyer only -----------", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 1, 11, "", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 0, 12, "CALL (buy)", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 12, gate_call, text_color=gate_call_col, text_size=size.small)
    table.cell(t, 0, 13, "PUT (buy)", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 13, gate_put, text_color=gate_put_col, text_size=size.small)
    table.cell(t, 0, 14, "-- Pattern --------------------", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 1, 14, "", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 0, 15, "State", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 15, pattern_str, text_color=pattern_col, text_size=size.small)
    table.cell(t, 0, 16, "-- Key Levels -----------------", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 1, 16, "", text_color=c_sep, bgcolor=bg_sep, text_size=size.tiny)
    table.cell(t, 0, 17, "52W High", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 17, fp(high_52w), text_color=color.orange, text_size=size.small)
    table.cell(t, 0, 18, "R1  nearest above", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 18, fp(r1), text_color=color.red, text_size=size.small)
    table.cell(t, 0, 19, "R2", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 19, fp(r2), text_color=color.rgb(220, 110, 110), text_size=size.small)
    table.cell(t, 0, 20, "S1  nearest below", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 20, fp(s1), text_color=color.green, text_size=size.small)
    table.cell(t, 0, 21, "S2", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 21, fp(s2), text_color=color.rgb(110, 220, 110), text_size=size.small)
    table.cell(t, 0, 22, "52W Low", text_color=c_lbl, text_size=size.small)
    table.cell(t, 1, 22, fp(low_52w), text_color=color.teal, text_size=size.small)
